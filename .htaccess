# =========================================================
#  Portal Ilha da Gigóia — configuração Apache
# =========================================================

ErrorDocument 404 /404.shtml

# ── Compressão ───────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Cache do navegador ───────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 7 days"
  ExpiresByType image/png               "access plus 7 days"
  ExpiresByType image/webp              "access plus 7 days"
  ExpiresByType image/avif              "access plus 7 days"
  ExpiresByType image/svg+xml           "access plus 7 days"
  ExpiresByType image/x-icon            "access plus 7 days"
  ExpiresByType font/woff2              "access plus 7 days"
  ExpiresByType text/css                "access plus 0 seconds"
  ExpiresByType text/javascript         "access plus 0 seconds"
  ExpiresByType application/javascript  "access plus 0 seconds"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Nomes de arquivo nao mudam entre publicacoes, entao CSS e JS sao sempre
  # revalidados (o ETag evita baixar de novo quando nada mudou).
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|shtml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # O service worker nunca pode ficar preso em cache
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Tipos MIME ───────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# ── Bloqueia arquivos internos ───────────────────────────
<IfModule mod_authz_core.c>
  <FilesMatch "^\.(git|DS_Store)|\.md$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^\.(git|DS_Store)|\.md$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# ── A antiga ilha-hoje.html virou parte de a-ilha.html ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ilha-hoje\.html$ /a-ilha.html [R=301,L]
  RewriteRule ^(en|es|zh)/ilha-hoje\.html$ /$1/a-ilha.html [R=301,L]
</IfModule>


# ── maracuja.html (espaco de eventos) virou parte de restaurante-maracuja.html ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^maracuja\.html$ /restaurante-maracuja.html [R=301,L]
  RewriteRule ^(en|es|zh)/maracuja\.html$ /$1/restaurante-maracuja.html [R=301,L]
</IfModule>

# ── QR do adesivo/flyer: endereco que so' existe dentro do QR (25/10/2026) ──
# Quem escaneia chega na home com a marca do flyer, e o GA4 separa "qr" de "digitado"
# (o digitado vem do ilhadagigoia.com, encaminhado na GoDaddy). Como o endereco e'
# so' do QR, o destino e a campanha podem mudar AQUI sem reimprimir nada. 302 de
# proposito: 301 fica gravado no celular de quem ja' escaneou e a troca nao pega.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^q/?$ /?utm_source=flyer&utm_medium=impresso&utm_campaign=flyer_v2&utm_content=qr [R=302,L,NC]
</IfModule>

